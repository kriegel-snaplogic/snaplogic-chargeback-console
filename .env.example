# SnapLogic Chargeback Console — configuration
#
# Copy to .env and fill in. Everything here is optional: with no .env at all the
# console runs entirely on the bundled demo fixtures, which is the intended way
# to try it out.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real tokens.

# ── Control plane ─────────────────────────────────────────────────────────────
# Your SnapLogic control plane URL and org name. Used to auto-register a
# connection on startup so you don't have to add one in the UI each time.
SNAPLOGIC_SERVER=https://elastic.snaplogic.com
SNAPLOGIC_ORG=YourOrgName

# ── Platform API credentials ──────────────────────────────────────────────────
# Either Basic Auth (user + password) or a bearer token. Used to read runtime
# executions, project paths and the org user list directly from the Public API.
SNAPLOGIC_USER=
SNAPLOGIC_PASSWORD=
# SNAPLOGIC_TOKEN=

# ── Snowflake-backed history (optional) ───────────────────────────────────────
# For orgs with more execution history than the Public API will return, the
# console can read from a Snowflake table filled by a scheduled pipeline. Three
# SnapLogic triggered tasks back this; see snowflake_client.py.
#
# Leave unset to stay on the bundled fixtures.
SNAPLOGIC_USE_SNOWFLAKE=false

# Read path — returns execution rows (GET).
SL_READ_ENDPOINT=
SL_READ_BEARER=

# Daily ingest — pulls yesterday's executions into Snowflake (POST).
SL_INGEST_ENDPOINT=
SL_INGEST_BEARER=

# Ad-hoc ingest — re-ingests an explicit date range (POST).
SL_ADHOC_ENDPOINT=
SL_ADHOC_BEARER=

# ── Admin gate ────────────────────────────────────────────────────────────────
# The admin pages sit behind Google OAuth, with a PIN as fallback. Both are read
# from Streamlit secrets, not from here — put them in .streamlit/secrets.toml:
#
#   demo_pin = "your-pin"
#   allowed_email_domain = "yourcompany.com"   # optional OAuth domain restriction
#
#   [auth]
#   redirect_uri = "http://localhost:8501/oauth2callback"
#   cookie_secret = "a-random-string"
#   [auth.google]
#   client_id = "..."
#   client_secret = "..."
#   server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
